{
  "name": "nest-typescript-starter",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "serve": "node scripts/migrate.mjs --optional && nest build && pm2 startOrReload ecosystem.config.cjs && pm2 save",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "serve:status": "pm2 status lazo-api",
    "serve:logs": "pm2 logs lazo-api",
    "serve:stop": "pm2 stop lazo-api && pm2 save"
  },
  "dependencies": {
    "@clerk/express": "^2.1.69",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.2",
    "@nestjs/platform-express": "^12.0.1",
    "@supabase/supabase-js": "^2.117.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.29.0",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supabase": "^2.117.0",
    "supertest": "^7.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
