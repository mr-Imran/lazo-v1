# Clerk — https://dashboard.clerk.com → API keys
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — https://supabase.com/dashboard → your project → Settings → API keys
# SUPABASE_URL is https://<project-ref>.supabase.co
# The secret key (sb_secret_...) bypasses row level security: server only,
# never shipped to the browser, never committed. Older projects call this
# SUPABASE_SERVICE_ROLE_KEY and that name still works.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# API payload encryption
# 32 bytes as 64 hex characters (or 44 base64). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Share it only with trusted API clients — anyone holding it can read every
# payload. This is layered on top of HTTPS, not a replacement for it.
API_ENCRYPTION_KEY=
# off      — no wrapping at all
# optional — wrap when the client sends the x-lazo-encrypted header (default)
# required — reject plain requests to /api, except the few @PlainPayload routes
API_ENCRYPTION_MODE=optional

# NestJS Observe (optional) — https://observe.nestjs.com
# Leave both blank to disable telemetry entirely.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Comma-separated browser origins allowed to call the API directly (CORS).
# The Vite dev server proxies /api and does not need this; a built frontend does.
# Defaults to http://localhost:5173,http://localhost:4173 when unset.
CORS_ORIGINS=

# Clerk webhook (optional) — Clerk dashboard → Webhooks → add endpoint
# https://<api host>/api/webhooks/clerk, events user.created / user.updated /
# user.deleted, then paste its signing secret (whsec_...) here. Without it the
# users table is still filled on every sign-in via POST /api/users/me/sync.
CLERK_WEBHOOK_SIGNING_SECRET=

# Domain the FRONTEND serves event sites under: an event with subdomain
# "rajib-jerin" is at <scheme>://rajib-jerin.<SITE_DOMAIN>. This server only
# supplies site data (GET /api/sites/by-slug/:slug).
# Local testing: SITE_DOMAIN=localhost:5173 (Vite dev server) — browsers send
# every *.localhost name to this machine, so no DNS or hosts-file change is
# needed. Production: SITE_DOMAIN=lazo.com plus a wildcard DNS record
# (*.lazo.com) pointing at the frontend host.
SITE_DOMAIN=
# http or https. Optional: localhost / lvh.me default to http, others to https.
SITE_SCHEME=

# Origins that serve this server's own dashboard, comma-separated. Clerk only
# accepts session tokens minted for these plus CORS_ORIGINS (authorizedParties).
# Defaults to http://localhost:<PORT>. Set it if you open the dashboard on
# another host (e.g. 127.0.0.1 or the production API domain).
DASHBOARD_ORIGINS=

# Postgres connection string, used only by `npm run db:migrate` (and `npm run serve`,
# which migrates first) to apply supabase/migrations automatically. Server-side secret.
# Supabase → Project Settings → Database → Connection string → Session pooler (URI).
DATABASE_URL=

# --- Payments (Stripe Checkout). Plans are sold from the services table.
STRIPE_SECRET_KEY=
# From Stripe → Developers → Webhooks, endpoint https://<api host>/api/webhooks/stripe
# (events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired).
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends hosts back to. Defaults to the first CORS origin.
APP_URL=

# --- Messaging (Premium plan). Email through Resend, SMS through Twilio.
RESEND_API_KEY=
MESSAGE_FROM_EMAIL="Lazo <hola@yourdomain.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# An E.164 number (+52…) or a Messaging Service SID (MG…).
TWILIO_FROM=

# --- Chat. Every message is also appended as JSONL here (for AI training), with
# sender ids hashed using CHAT_LOG_SALT. Defaults to <lazobackend>/data/chats.
CHAT_LOG_DIR=
CHAT_LOG_SALT=

# --- WhatsApp Business Cloud API (Premium plan; PRD 6.4). Meta for Developers →
# your app → WhatsApp → API setup. Use a permanent System User token, not the
# 24-hour test token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Webhook: app → WhatsApp → Configuration → callback URL
# https://<api host>/api/webhooks/whatsapp, subscribe to "messages" and
# "message_template_status_update". Pick any verify token and paste it here;
# the app secret is under app Settings → Basic (signs X-Hub-Signature-256).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Vendor payments. Hosts pay vendor quotes into LAZO's OWN Stripe account
# (uses STRIPE_SECRET_KEY above); Lazo keeps its commission and settles the net
# with each vendor separately. Vendors do NOT connect their own Stripe account.
# Webhook endpoint https://<api host>/api/webhooks/stripe-connect, a normal
# account endpoint subscribed to payment_intent.succeeded, checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired, charge.refunded,
# charge.dispute.created/updated/closed. (No Connect endpoint / account.updated is
# needed any more; the value still accepts a comma-separated list of secrets.)
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Analytics warehouse (schema `analytics`, migration 20261013000000_analytics_warehouse.sql).
# Read over the direct DATABASE_URL above (supabase-js only sees `public`).
# Minutes between scheduled ingest runs. Default 360 (6 h); 0 disables the
# in-process scheduler (use POST /api/admin/analytics/ingest or pg_cron instead).
ANALYTICS_INGEST_INTERVAL_MINUTES=
# Mercado Pago access token (APP_USR-...), used only to reconcile revenue
# against Mercado Pago's payment records. Leave blank to mark it "unchecked".
MERCADOPAGO_ACCESS_TOKEN=

# --- Retailer catalogs for the registry (retailers table; src/retailers).
# Amazon Product Advertising API 5.0 for amazon.com.mx — https://affiliate-program.amazon.com.mx
# → Tools → Product Advertising API. Needs an approved Associates account.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
# Your Associates tracking id, e.g. lazo-20. Goes into every product link.
AMAZON_PAAPI_PARTNER_TAG=
# Mercado Libre app — https://developers.mercadolibre.com.mx → Mis aplicaciones.
# Search and item lookups use an app token (client_credentials).
MELI_APP_ID=
MELI_CLIENT_SECRET=

# --- Fulfilment partners (print, flowers, travel; src/fulfilment).
# Partner emails go through RESEND_API_KEY + MESSAGE_FROM_EMAIL above. The
# status-update URL sent to partners is built from this API's public origin;
# set it when the server sits behind a proxy (e.g. https://api.lazo.com).
API_PUBLIC_URL=

# --- Payments: Mercado Pago (second event-fee gateway, Checkout Pro).
# Access token from https://www.mercadopago.com.mx/developers → Your integrations
# → the app → Production credentials (TEST-… tokens work with test users).
MERCADOPAGO_ACCESS_TOKEN=
# Webhook "secret signature" shown when registering https://<api host>/api/webhooks/mercadopago
# (topic: Payments). Used to verify the x-signature header.
MERCADOPAGO_WEBHOOK_SECRET=
# Public https URL of this API, so checkout preferences carry a notification_url.
# Leave blank on a laptop: the return page confirms the payment instead.
API_URL=
# Gateway used when the host does not pick one: stripe | mercadopago.
# Overrides payment_gateways.is_default. Blank = the table's default.
PAYMENTS_DEFAULT_GATEWAY=

# --- Proxy / rate limits.
# Number of reverse proxies (load balancer, Nginx, Cloudflare) in front of this
# server. Express then reads the client IP from X-Forwarded-For so rate limits
# apply per visitor instead of per proxy. 0 on a laptop or when exposed directly.
TRUST_PROXY_HOPS=0
